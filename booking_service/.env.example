# Copy this file to .env and put your own values. Never commit .env
# These settings are for running on your PC (npm start).
# In Lambda, the settings are set on the function by infra/deploy-lambda.sh

# Floci (local AWS)
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1

# Where the package service (Marwan) is running
PACKAGE_SERVICE_URL=http://localhost:3001

# SNS topic used by the review & notification service (Ahmed) to email customers
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:booking-status-topic

PORT=3002
