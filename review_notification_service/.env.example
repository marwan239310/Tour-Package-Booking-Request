# Copy this file to .env and fill in your own values. Never commit .env
# These settings are for running on your PC (npm start).
# In Lambda, the settings are on the function, and the Brevo key comes from Secrets Manager.

# Floci (local AWS) and your resources
AWS_ENDPOINT=http://localhost:4566
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:booking-status-topic
SECRET_ID=tour-booking/brevo
PORT=3003
# Marwan's package service (to give seats back when staff reject or cancel)
PACKAGE_SERVICE_URL=http://localhost:3001

# Brevo settings: only needed once, for infra/store-secret.sh (it copies them into Secrets Manager)
BREVO_API_KEY=your-brevo-api-key
SENDER_EMAIL=your-verified-sender@example.com
SENDER_NAME=Tour Booking

# Testing only: send every email to this address instead of the real customer
