{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndUpdateBookingRequests",
      "Effect": "Allow",
      "Action": ["dynamodb:Scan", "dynamodb:GetItem", "dynamodb:UpdateItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/BookingRequests"
    },
    {
      "Sid": "WriteAndReadStatusHistory",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:Query"],
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/StatusHistory"
    },
    {
      "Sid": "PublishStatusChanges",
      "Effect": "Allow",
      "Action": ["sns:Publish", "sns:ConfirmSubscription"],
      "Resource": "arn:aws:sns:us-east-1:000000000000:booking-status-topic"
    },
    {
      "Sid": "ReadBrevoSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-east-1:000000000000:secret:tour-booking/brevo-*"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/review-notification-service:*"
    }
  ]
}