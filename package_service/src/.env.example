# Copy to .env for local runs (npm start / docker compose). Never commit .env.
PORT=3001
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
DYNAMODB_ENDPOINT=http://localhost:4566
DYNAMODB_TABLE=Packages

# Websites allowed to call the API from a browser (comma-separated)
CORS_ORIGINS=http://localhost:4566,http://localhost:8080

# Team Cognito user pool (staff-only endpoints)
COGNITO_ISSUER=http://localhost:4566/us-east-1_xxxxxxxx
COGNITO_JWKS_URL=http://localhost:4566/us-east-1_xxxxxxxx/.well-known/jwks.json
COGNITO_CLIENT_ID=
STAFF_GROUP=staff

# External exchange-rate API (free, no key needed)
EXCHANGE_API_URL=https://api.frankfurter.dev/v2
